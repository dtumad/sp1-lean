import Clean.Backends.Plonky3.Print

/-! # Shared assembly fixture files

Only file organization lives here. Clean owns validated lowering, component printing and assembly
printing. Exact printed component-and-mode equality determines sharing in first-use order.
-/

namespace SP1CleanTest.Alignment.SharedAssemblyExport

open Lean

/-- The emitted component bodies and each assembly's ordered references to them. -/
structure State where
  components : Array String := #[]
  assemblies : Array (String × Array Nat) := #[]

/-- Write an assembly using upstream printers and reuse byte-identical component bodies. -/
def write {F : Type} [FiniteField F] (state : IO.Ref State) (out : System.FilePath)
    (name : String) (program : Backends.Program F) : IO Unit := do
  let mut current ← state.get
  if current.assemblies.any (fun entry => entry.1 == name) then
    throw (IO.userError s!"duplicate assembly: {name}")
  let mut indices : Array Nat := #[]
  let mut aliases := ""
  for ((component, mode), position) in (program.components.zip program.modes).zipIdx do
    let body := Backends.Plonky3.Print.componentToRust component mode
    let index := (current.components.toList.idxOf? body).getD current.components.size
    if index == current.components.size then
      IO.FS.writeFile (out / s!"shared_component_{index}.rs") body
      current := { current with components := current.components.push body }
    indices := indices.push index
    aliases := aliases ++ s!"pub use super::shared_component_{index} as component_{position};\n"
  IO.FS.writeFile (out / s!"{name}.rs")
    (aliases ++ Backends.Plonky3.Print.assemblyToRust program)
  state.set { current with assemblies := current.assemblies.push (name, indices) }

/-- Emit the library module catalog and its checked file inventory. -/
def finish (state : IO.Ref State) (out : System.FilePath) : IO Unit := do
  let current ← state.get
  let components := (List.range current.components.size).map fun index =>
    s!"shared_component_{index}.rs"
  let mut catalog := "// Generated by Clean's shared component and assembly printers.\n"
  for index in List.range current.components.size do
    catalog := catalog ++ s!"#[path = \"shared_component_{index}.rs\"]\npub mod shared_component_{index};\n"
  for (name, _) in current.assemblies do
    catalog := catalog ++ s!"#[path = \"{name}.rs\"]\npub mod {name};\n"
  IO.FS.writeFile (out / "shared_assemblies.rs") catalog
  IO.FS.writeFile (out / "shared_assemblies.json") ((Json.mkObj [
    ("components", toJson components),
    ("assemblies", Json.mkObj (current.assemblies.toList.map fun (name, indices) =>
      (name, toJson indices)))]).compress ++ "\n")

end SP1CleanTest.Alignment.SharedAssemblyExport
