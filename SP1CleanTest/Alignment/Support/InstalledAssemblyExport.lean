module

public import SP1CleanTest.Alignment.Support.InstalledAssemblyInventory
public import SP1CleanTest.Alignment.Support.ProviderGeneration
public import SP1CleanTest.Core.ProgramExport
public import SP1CleanTest.Core.WritePermissionExport

/-! # Export fixture for the complete installed native assembly

Explicit instance data supplies program, source, target and host endpoints. Consumer inputs
retain their original physical component positions, including all required boundary terminals.
Clean's scheduler closes provider demands, preserving empty dynamic tables. Private inputs
use Clean's named hint tables, so the same exported program also runs on mutated inputs.
This finite comparison fixture does not claim general generation completeness or lowering
correctness; its production components retain their native semantic proofs.
-/

@[expose] public section

namespace SP1CleanTest.Alignment.InstalledAssemblyExport

open Circuit Air.Flat SP1Clean SP1Clean.Soundness SP1CleanTest.Alignment.InstalledAssembly SP1CleanTest.Core

/-- All installed components and the complete authenticated channel registry. -/
def installed (context : Context) := (assembly context).withChannels (channels context)

/-- Consumer inputs in their original physical table order. -/
def rows (consumers : List Seed) (index : ℕ) : List (List Fp) :=
  (consumers.filter fun seed => seed.table == index).map (·.cells)

/-- Flattened consumer input; provider rows are generated by Clean. -/
def privateInput (context : Context) (consumers : List Seed) : Array Fp :=
  ((installed context).tables.zipIdx.flatMap fun (_, index) => (rows consumers index).flatten).toArray

/-- Each preallocated consumer reads its own slice of the ordinary private input. -/
def hintTables (context : Context) (consumers : List Seed) : List HintTable :=
  ((installed context).tables.zipIdx.foldl (fun (acc : ℕ × List HintTable) (component, index) =>
    let count := (rows consumers index).length
    (acc.1 + count * component.rowOffset,
      acc.2 ++ [{
        key := component.circuit.name
        width := component.rowOffset
        offset := acc.1
        rows := count }])) (0, [])).2

/-- Test wrapper with no additional semantic theorem attached to the export. -/
def fixture (context : Context) (consumers : List Seed) : FormalEnsemble Fp SP1PublicIO :=
  { ComponentExport.fixture (installed context) (fields (privateInput context consumers).size) with
    hintTables := hintTables context consumers }

/-- Existing byte, ROM and permission routes plus immutable-table count handlers. -/
def config (context : Context) (consumers : List Seed) : Except String (WitnessGeneration.Config Fp) := do
  let tables := (installed context).tables
  unless consumers.all (seedValid tables) do
    throw "consumer input names an absent/fixed table or has the wrong width"
  let overrides := ProviderGeneration.byteConfig.components ++
    (ProgramExport.config context.image).components ++ (WritePermissionExport.config context.image).components
  let components ← tables.zipIdx.mapM fun (component, index) => do
    let inputs := rows consumers index
    unless inputs.all (fun cells => cells.length == component.rowOffset) do
      throw s!"wrong input width for {component.circuit.name}"
    unless inputs.length < UInt64.size do
      throw s!"too many inputs for {component.circuit.name}"
    let mode ← match overrides.find? (fun entry => entry.1 == component.circuit.name) with
      | some (_, generation) => pure generation.mode
      | none => match component.fixedColumns with
        | some fixed => pure <| .preallocated {
          rows := fixed.height
          input := .ofFExprs #v[.const 0]
          input_valid := by rfl
          handlers := [{ interaction := 0, column := fixed.width }]
        }
        | none => pure <| .preallocated {
          rows := UInt64.ofNat inputs.length
          input := .ofFExprs (Vector.ofFn fun column : Fin component.rowOffset =>
            .hintGet component.circuit.name component.rowOffset .idx column)
          input_valid := by simp [Witgen.RowProgram.Valid, Witgen.RowProgram.ofFExprs,
            Witgen.VExpr.validForRow, Witgen.FExpr.validForRow,
            Witgen.U64Expr.validForRow, Witgen.RowProgram.Source.allowsHints]
          handlers := []
        }
    pure (component.circuit.name, ({
      mode
      padding := { input := Array.replicate component.rowOffset 0, minimumRows := 0 }
    } : WitnessGeneration.Generation Fp))
  pure { components, fuel := 512 }

/-- Generate the same complete indexed witness that the emitted Rust must reproduce. -/
def generate (context : Context) (consumers : List Seed) (publicInput : SP1PublicIO Fp)
    (input : fields (privateInput context consumers).size Fp := ⟨privateInput context consumers, rfl⟩) :=
  (config context consumers).bind fun generation =>
    WitnessGeneration.generate (fixture context consumers) generation publicInput input
    |>.mapError toString

/-- Export the installed circuits through Clean's built-in lowering and printer. -/
def exportRust (context : Context) (consumers : List Seed) : Except String String :=
  (config context consumers).bind (Backends.Plonky3.Print.ensembleToRust (fixture context consumers))


end SP1CleanTest.Alignment.InstalledAssemblyExport
