import SP1Clean.Export.WriteMixedHostTables

/-! # Physical assembly of the remaining native host protocols

Install the generated commitment banks and four ordinary observation tables at their typed
positions in the existing Memory-source assembly. The residual generators can only fill the
41 remaining original positions.
-/

namespace SP1Clean.Export.WriteMixedHostTables

open Circuit Air.Flat Semantics Soundness Machine TraceGen FormalModel.Shard
open WriteSourceRegistry

private abbrev F := ZMod SP1Prime

variable (image : ProgramImage) (source target : ExecutionSnapshot) (finish : HostHintQueue.State F)

private abbrev components := (base image source target finish).tables.drop 6

/-- Positions not yet generated by the original Memory or commitment/observation compilers. -/
def Remaining := (i : Fin (components image source target finish).length) →
  sourceAt (6 + i.val) = none → indexAt (6 + i.val) = none →
    { t : Table F // t.component = (components image source target finish)[i] }

variable {image source target finish} {limits : ResourceLimits} {events : List ExecutionEvent}
    (run : AdmissibleExecution limits SP1Prime image source target events) (data : ProverData F)

/-- Install the physically generated bank/observation tables. Other providers see exactly
the indices excluded by both registries. -/
noncomputable def install (remaining : Remaining image source target finish) : WriteMixedSourceTables.Remaining image source target finish :=
  fun i absent => match found : indexAt (6 + i.val) with
    | none => remaining i absent found
    | some id => ⟨table run data id, by
        have atSlot := registered_at image source target finish id
        rw [position_of_indexAt found, ← List.getElem?_drop, List.getElem?_eq_getElem i.isLt] at atSlot
        exact (registered run data id).trans (Option.some.inj atSlot).symm⟩

/-- Each generated slot inherits the validity of its own physical construction. -/
theorem install_valid (remaining : Remaining image source target finish)
    (checked : ∀ i absent missing, let t := (remaining i absent missing).1; t.Constraints ∧ t.Guarantees) :
    ∀ i absent, let t := (install run data remaining i absent).1; t.Constraints ∧ t.Guarantees := by
  intro i absent
  dsimp only [install]
  split
  · exact checked i absent _
  · exact valid run data _

/-- The literal table is the one emitted by its generator at every resolved position. -/
theorem install_at (remaining : Remaining image source target finish)
    (i : Fin (components image source target finish).length) (absent : sourceAt (6 + i.val) = none)
    {id : Index} (found : indexAt (6 + i.val) = some id) :
    (install run data remaining i absent).1 = table run data id := by
  dsimp only [install]
  split
  · rename_i h
    have impossible : (none : Option Index) = some id := h.symm.trans found
    cases impossible
  · rename_i other h
    obtain rfl := Option.some.inj (h.symm.trans found)
    rfl

/-- With its residual slots filled by their individual generators, the original 98-table
supervisor is checked at its own canonical global prover data. -/
theorem supervisor_constraints {rows : List MixedCompiledRow}
    (release : ReleaseAdmissibleExecution (.native SP1Prime) SP1Prime image source target events)
    (routed : routeMixedRows? (policy SP1Prime image) image.program AccessFrontier.initial source.realize events = some rows)
    (header : SP1PublicIO F) (hint : ProverHint F) (packets : List WriteObservations.Packet)
    (remaining : Remaining image source target finish)
    (checked : ∀ i absent missing, let t := (remaining i absent missing).1; t.Constraints ∧ t.Guarantees) :
    (WriteMixedSourceTables.ofExecution release routed finish data hint header
      (install release.1 data remaining) packets).Constraints :=
  WriteMixedSourceTables.ofExecution_constraints release routed finish data hint header _
    packets (install_valid release.1 data remaining checked)

end SP1Clean.Export.WriteMixedHostTables
