import SP1Clean.Export.WriteAllocationPreset
import SP1Clean.Export.WriteInstalledAllocations
import ToClean.Air.MessageFilter

/-! # Installing the shared allocation word table on all four WRITE protocols

The grouped guest words and the endpoint block provider occupy different physical positions
from the four allocation tables. All four joins retain the same funded word rows when Clean
rebinds the entire witness to its canonical data.
-/

namespace SP1Clean.Export.WriteObservationAssembly

open Circuit Air.Flat Semantics Machine FormalModel.Shard WriteSourceRegistry WriteAllocation
open WriteEffects.Witness

private abbrev F := ZMod SP1Prime

/-- Channels whose participating components are all generated by the six-table constructor. -/
def fundedProtocols : List (RawChannel F) := WriteEffects.blockChannel.toRaw :: allocationProtocols

variable {source target : ExecutionSnapshot} {entries : List Entry}

/-- Merge the generated tables into physical registry order around the packet, snapshot and
slice tables. Each table occurs at exactly one position. -/
def fundedSuffix (s : SixTables entries source.host target.host) (data : ProverData F)
    (early hints plans : List (Table F)) : List (Table F) :=
  early ++ [s.groups data] ++ hints ++ [s.fixed data] ++ plans ++ [s.calls data,s.nodes data,s.seeds data,s.words data]

theorem fundedSuffix_registered (s : SixTables entries source.host target.host) (data : ProverData F)
    (early hints plans : List (Table F))
    (he : early.map Table.component = (tables source target).take 9)
    (hh : hints.map Table.component = ((tables source target).drop 10).take 2)
    (hp : plans.map Table.component = ((tables source target).drop 13).take 2) :
    (fundedSuffix s data early hints plans).map Table.component = tables source target := by
  simp only [fundedSuffix,List.map_append,he,hh,hp]
  rfl

private theorem silent_part (xs : List (Table F)) (cs : List (Component F)) (reg : xs.map Table.component = cs)
    (ch : RawChannel F) (absent : ch.name ∉ cs.flatMap (fun c => c.circuit.channels.map RawChannel.name)) :
    xs.flatMap (·.interactionsWith ch) = [] := by
  apply List.flatMap_eq_nil_iff.mpr
  intro t used
  apply t.interactionsWith_nil_of_channel_not_mem
  exact fun here => absent (List.mem_flatMap.mpr ⟨t.component, reg ▸ List.mem_map_of_mem used, List.mem_map_of_mem here⟩)

private theorem silent_one (t : Table F) (ch : RawChannel F) (absent : ch.name ∉ t.component.circuit.channels.map RawChannel.name) :
    t.interactionsWith ch = [] :=
  t.interactionsWith_nil_of_channel_not_mem (fun member => absent (List.mem_map_of_mem member))

private def participants (s : SixTables entries source.host target.host) (data : ProverData F) : List (Table F) :=
  [s.groups data,s.fixed data,s.calls data,s.nodes data,s.seeds data,s.words data]

private theorem block_perm (s : SixTables entries source.host target.host) (data : ProverData F) :
    let ch := (WriteEffects.blockChannel (p := SP1Prime)).toRaw
    ((participants s data).flatMap (·.interactionsWith ch)).Perm (s.blockLedger data) := by
  intro ch
  simp only [participants,List.flatMap_cons,List.flatMap_nil,List.append_nil,
    silent_one (s.calls data) ch (of_decide_eq_true rfl),silent_one (s.nodes data) ch (of_decide_eq_true rfl),
    silent_one (s.seeds data) ch (of_decide_eq_true rfl),List.nil_append,SixTables.blockLedger,List.append_assoc]
  exact List.perm_append_comm.append_left _

private theorem private_ledger (s : SixTables entries source.host target.host) (data : ProverData F)
    (ch : RawChannel F) (member : ch ∈ allocationProtocols) :
    (participants s data).flatMap (·.interactionsWith ch) ∈ s.privateLedgers data := by
  simp only [allocationProtocols,List.mem_cons,List.not_mem_nil,or_false] at member
  rcases member with rfl | rfl | rfl
  · let c := (cursorChannel (p := SP1Prime)).toRaw
    change (participants s data).flatMap (·.interactionsWith c) ∈ s.privateLedgers data
    simp only [participants,List.flatMap_cons,List.flatMap_nil,
      silent_one (s.groups data) c (of_decide_eq_true rfl),silent_one (s.fixed data) c (of_decide_eq_true rfl),
      silent_one (s.seeds data) c (of_decide_eq_true rfl),silent_one (s.words data) c (of_decide_eq_true rfl),
      List.nil_append,List.append_nil]
    exact List.Mem.head _
  · let c := (contentsChannel (p := SP1Prime)).toRaw
    change (participants s data).flatMap (·.interactionsWith c) ∈ s.privateLedgers data
    simp only [participants,List.flatMap_cons,List.flatMap_nil,
      silent_one (s.groups data) c (of_decide_eq_true rfl),silent_one (s.fixed data) c (of_decide_eq_true rfl),
      silent_one (s.calls data) c (of_decide_eq_true rfl),silent_one (s.words data) c (of_decide_eq_true rfl),
      List.nil_append,List.append_nil]
    exact List.Mem.tail _ (List.Mem.head _)
  · let c := (Words.cursorChannel (p := SP1Prime)).toRaw
    change (participants s data).flatMap (·.interactionsWith c) ∈ s.privateLedgers data
    simp only [participants,List.flatMap_cons,List.flatMap_nil,
      silent_one (s.groups data) c (of_decide_eq_true rfl),silent_one (s.fixed data) c (of_decide_eq_true rfl),
      silent_one (s.calls data) c (of_decide_eq_true rfl),silent_one (s.nodes data) c (of_decide_eq_true rfl),
      List.nil_append,List.append_nil]
    exact List.Mem.tail _ (List.Mem.tail _ (List.Mem.head _))

private theorem matched_perm {a b : List (Interaction F)} (same : a.Perm b) (signed : LogUpBalanced b)
    (fit : (Balance.logUp (F := F)).fits b.length = true) (matched : BalancedInteractions b) :
    LogUpBalanced a ∧ (Balance.logUp (F := F)).fits a.length = true ∧ BalancedInteractions a := by
  rw [same.length_eq]
  exact ⟨fun m => (balanceOf_perm same).trans (signed m),fit,BalancedInteractions.of_perm matched same.symm⟩

attribute [local irreducible] base preprocessing withSources assembly

/-- Construct all six funded tables from the admitted execution before the other generators
are supplied. Every physical completion at the original registry positions retains signed
balance, characteristic fit and message matching for the four generated protocols. -/
theorem installed_funded_write_allocation {ctx : InstalledAssembly.Context} {events : List ExecutionEvent}
    (run : AdmissibleExecution ctx.limits SP1Prime ctx.image ctx.source ctx.target events)
    (preset : ctx.limits.LE InstalledAssembly.fixedProviderPreset) (data : ProverData F)
    (nodeReads : HintQueue.NodeRecord F → F) (wordReads : HintQueue.WordRecord F → F) :
    ∃ entries, native? ctx.image ctx.source events ⟨nodeReads,fun _ => 0,wordReads⟩ = some entries ∧
      ∃ s : SixTables entries ctx.source.host ctx.target.host, InstalledAssembly.MatchedWriteAllocation s data ∧
        ∀ {final : HostHintQueue.State F} (w : EnsembleWitness (base ctx.image ctx.source ctx.target final)) (early hints plans : List (Table F))
          (he : early.map Table.component = (tables ctx.source ctx.target).take 9)
          (hh : hints.map Table.component = ((tables ctx.source ctx.target).drop 10).take 2)
          (hp : plans.map Table.component = ((tables ctx.source ctx.target).drop 13).take 2),
          let full := withPublicChecks (build w (fundedSuffix s data early hints plans) (fundedSuffix_registered s data early hints plans he hh hp))
          ∀ ch ∈ fundedProtocols, LogUpBalanced (full.interactionsWith ch) ∧
            (Balance.logUp (F := F)).fits (full.interactionsWith ch).length = true ∧ BalancedInteractions (full.interactionsWith ch) := by
  obtain ⟨entries,collected,s,paid⟩ := InstalledAssembly.fixedProviderPreset_write_allocation run preset data nodeReads wordReads
  refine ⟨entries,collected,s,paid,?_⟩
  intro final w early hints plans he hh hp full ch which
  have member := which
  simp only [fundedProtocols,allocationProtocols,List.mem_cons,List.not_mem_nil,or_false] at member
  have fresh : ch ∈ channels := by
    rcases member with rfl | rfl | rfl | rfl <;> simp [channels]
  have publicSilent : ch.name ∉ [(WriteEffects.cursorChannel (p := SP1Prime)).name,(WriteEffects.closeChannel (p := SP1Prime)).name] := by
    rcases member with rfl | rfl | rfl | rfl <;> decide
  have se := silent_part early _ he ch (by rcases member with rfl | rfl | rfl | rfl <;> exact of_decide_eq_true rfl)
  have sh := silent_part hints _ hh ch (by rcases member with rfl | rfl | rfl | rfl <;> exact of_decide_eq_true rfl)
  have sp := silent_part plans _ hp ch (by rcases member with rfl | rfl | rfl | rfl <;> exact of_decide_eq_true rfl)
  dsimp only [full]
  rw [withPublicChecks_ledger _ ch (protocol_installed _ _ _ _ ch fresh) publicSilent,build_ledger,
    (installSources w).interactionsWith_nil_of_not_registered _ (protocol_fresh _ _ _ _ ch fresh)]
  have ledger : (fundedSuffix s data early hints plans).flatMap (·.interactionsWith ch) =
      (participants s data).flatMap (·.interactionsWith ch) := by
    simp only [fundedSuffix,participants,List.flatMap_append,List.flatMap_cons,List.flatMap_nil,List.append_nil,
      se,sh,sp,List.nil_append,List.append_assoc]
  rw [List.nil_append,ledger]
  rcases List.mem_cons.mp which with rfl | internal
  · exact matched_perm (block_perm s data) paid.blocks.signed paid.blockFit paid.blockMatches
  · exact paid.privateMatches _ (private_ledger s data ch internal)

end SP1Clean.Export.WriteObservationAssembly
