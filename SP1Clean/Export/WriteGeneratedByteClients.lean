import SP1Clean.Export.WriteOriginalByteDirections
import SP1Clean.Export.WriteMixedHostData

/-! # Collecting genuine supervisor readers before allocating Byte tables

At each original nonprovider position the mixed compiler already determines a table.
The corresponding cells are independent of the as-yet unallocated Byte window.
-/

namespace SP1Clean.Export.WriteGeneratedByteClients
open Circuit Air.Flat Semantics Soundness Machine TraceGen FormalModel.Shard Channels WriteSourceRegistry
open WriteProbe.AccessInventory
private abbrev F := ZMod SP1Prime
private abbrev bus := (byteChannel (p := SP1Prime)).toRaw

variable {image : ProgramImage} {initial final : ExecutionSnapshot} {events : List ExecutionEvent}
    (run : ReleaseAdmissibleExecution (.native SP1Prime) SP1Prime image initial final events)
    {rows : List MixedCompiledRow}
    (routed : routeMixedRows? (policy SP1Prime image) image.program AccessFrontier.initial initial.realize events = some rows)
    (finish : HostHintQueue.State F) (data : ProverData F) (hint : ProverHint F) (header : SP1PublicIO F)
    (packets : List WriteObservations.Packet)

private abbrev Rest := WriteMixedControlTables.Remaining

/-- Fill the original slots around an arbitrary generated Byte window. -/
noncomputable def supervisor (rest : Rest image initial final finish) : EnsembleWitness (base image initial final finish) :=
  let controls := WriteMixedControlTables.install run routed data rest
  let fixed := WriteMixedFixedResources.install run routed data hint packets controls
  WriteMixedSourceTables.ofExecution run routed finish data hint header (WriteMixedHostTables.install run.1 data fixed) packets

/-- A physical slot's generated cells, with its component and row conditions, prior to funding the Byte window. -/
structure Client (index : ℕ) where
  table : Table F
  component : (base image initial final finish).tables[index]? = some table.component
  checked : table.Constraints ∧ table.Guarantees
  cells : ∀ rest, ((supervisor run routed finish data hint header packets rest).tables.map Table.table)[index]? = some table.table

private abbrev grid := Client run routed finish data hint header packets

private theorem rows_at_boundary (rest : Rest image initial final finish) (i : Fin 6) :
    ((supervisor run routed finish data hint header packets rest).tables.map Table.table)[i.val]? =
      some ((WriteBoundaryBuild.boundaryTables initial.sail.memorySnapshot (MixedMemoryHistory.stream image initial events rows)
        (WriteBoundaryBuild.demandKeys events packets) (MixedMemoryHistory.canonical run.1 routed) data hint)[i.val]'i.isLt).table := by
  let head := WriteBoundaryBuild.boundaryTables initial.sail.memorySnapshot (MixedMemoryHistory.stream image initial events rows)
    (WriteBoundaryBuild.demandKeys events packets) (MixedMemoryHistory.canonical run.1 routed) data hint
  dsimp only [supervisor,WriteMixedSourceTables.ofExecution,WriteMixedSourceTables.build,WriteBoundaryBuild.build]
  rw [EnsembleWitness.ofTables_tables,withDerivedData_map_table,List.getElem?_map,
    List.getElem?_append_left (show i.val < head.length from i.isLt),List.getElem?_eq_getElem (show i.val < head.length from i.isLt)]
  rfl

private noncomputable def boundary (i : Fin 6) : grid run routed finish data hint header packets i.val := by
  let stream := MixedMemoryHistory.stream image initial events rows
  let keys := WriteBoundaryBuild.demandKeys events packets
  let canon := MixedMemoryHistory.canonical run.1 routed
  let head := WriteBoundaryBuild.boundaryTables initial.sail.memorySnapshot stream keys canon data hint
  have shape := WriteBoundaryBuild.boundaryTables_registered image initial final finish stream keys canon data hint
  have found := congrArg (fun xs : List (Component F) => xs[i.val]?) shape
  rw [List.getElem?_map,List.getElem?_eq_getElem (show i.val < head.length from i.isLt),
    Option.map_some,List.getElem?_take_of_lt i.isLt] at found
  exact ⟨head[i.val]'i.isLt,found.symm,WriteBoundaryBuild.boundaryTables_valid _ stream keys
    (MixedMemoryHistory.addresses_in_layout run.1 routed) data hint _ (List.getElem_mem (l := head) i.isLt),
    fun rest => rows_at_boundary run routed finish data hint header packets rest i⟩

private noncomputable def memory (id : Source) : grid run routed finish data hint header packets (position id) := by
  let t := WriteMixedSourceTables.compiledSource run routed data hint packets id
  have registered := WriteMixedSourceTables.compiledSource_registered run routed data hint packets id
  refine ⟨t,(original_at ..).trans (congrArg some registered.symm),WriteMixedSourceTables.compiledSource_valid ..,?_⟩
  intro rest
  let w := supervisor run routed finish data hint header packets rest
  let ref := originalSlot image initial final finish id
  have got : w.tables[ref.index.val]? = some (raw w id) := List.getElem?_eq_getElem (by rw [← w.same_length]; exact ref.index.isLt)
  change w.tables[(originalSlot image initial final finish id).index.val]? = _ at got
  rw [originalSlot_index] at got
  change (w.tables.map Table.table)[position id]? = some t.table
  rw [List.getElem?_map,got,Option.map_some]
  exact congrArg some (WriteMixedSourceTables.compiledSource_rows ..)

private noncomputable def host (id : WriteMixedHostTables.Index) :
    grid run routed finish data hint header packets (WriteMixedHostTables.position id) :=
  ⟨WriteMixedHostTables.table run.1 data id,
    (WriteMixedHostTables.registered_at image initial final finish id).trans (congrArg some (WriteMixedHostTables.registered run.1 data id).symm),
    WriteMixedHostTables.valid run.1 data id,fun _ => WriteMixedHostTables.original_arrays run routed data hint header _ packets id⟩

private noncomputable def fixed (id : WriteMixedFixedResources.Index) :
    grid run routed finish data hint header packets (WriteMixedFixedResources.position id) :=
  ⟨WriteMixedFixedResources.table run routed data hint packets id,
    (WriteMixedFixedResources.registered_at image initial final finish id).trans (congrArg some (WriteMixedFixedResources.table_component run routed data hint packets id).symm),
    WriteMixedFixedResources.table_valid run routed data hint packets id,fun _ => WriteMixedFixedResources.original_arrays run routed data hint packets header _ id⟩

private noncomputable def control (id : WriteMixedControlTables.Index) :
    grid run routed finish data hint header packets (WriteMixedControlTables.position id) :=
  ⟨WriteMixedControlTables.table run routed data id,
    (WriteMixedControlTables.registered_at image initial final finish id).trans (congrArg some (WriteMixedControlTables.table_component run routed data id).symm),
    WriteMixedControlTables.table_valid run routed data id,fun _ => WriteMixedControlTables.original_arrays run routed data hint packets header _ id⟩

/-- Select the real compiler table of any original reader. No provider counts or preexisting
completed witness are inputs to the selection. -/
noncomputable def atIndex (k : Fin 98) (outside : k.val < 32 ∨ 55 ≤ k.val) :
    grid run routed finish data hint header packets k.val := by
  by_cases head : k.val < 6
  · exact boundary run routed finish data hint header packets ⟨k.val,head⟩
  cases src : sourceAt k.val with
  | some id => exact position_of_sourceAt src ▸ memory run routed finish data hint header packets id
  | none =>
    cases h : WriteMixedHostTables.indexAt k.val with
    | some id => exact WriteMixedHostTables.position_of_indexAt h ▸ host run routed finish data hint header packets id
    | none =>
      cases f : WriteMixedFixedResources.indexAt k.val with
      | some id =>
        have pos := eq_of_beq (List.find?_some (p := fun id => WriteMixedFixedResources.position id == k.val) f)
        exact pos ▸ fixed run routed finish data hint header packets id
      | none =>
        cases c : WriteMixedControlTables.indexAt k.val with
        | some id =>
          have pos := eq_of_beq (List.find?_some (p := fun id => WriteMixedControlTables.position id == k.val) c)
          exact pos ▸ control run routed finish data hint header packets id
        | none =>
          have member : k.val ∈ (List.range' 6 ((base image initial final finish).tables.drop 6).length).filter
              (fun j => (sourceAt j).isNone && (WriteMixedHostTables.indexAt j).isNone &&
                (WriteMixedFixedResources.indexAt j).isNone && (WriteMixedControlTables.indexAt j).isNone) := by
            apply List.mem_filter.mpr
            refine ⟨List.mem_range'_1.mpr ?_,by simp [src,h,f,c]⟩
            rw [List.length_drop,base_length]
            omega
          rw [WriteMixedControlTables.remaining_positions,List.mem_range'_1] at member
          omega

end SP1Clean.Export.WriteGeneratedByteClients
