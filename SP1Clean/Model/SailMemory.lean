  refine (ContinuesWith.lift (run_readReg_of_isInitialized s Register.cur_privilege hs)).bind ?_
  refine (ContinuesWith.lift (run_effectivePrivilege_of_mprv_clear _ _ _ s
    (extractLsb_mstatus_mprv_eq_zero s hs hconfig.h_mprv_disabled))).bind ?_
  simp only [hconfig.h_cur_privilege]
  refine ContinuesWith.bind
    (value := (physaddr.Physaddr (zero_extend (m := 64) pc), page_based_mem_type.PBMT_PMA))
    (middle := s) ?_ ?_
  · refine (ContinuesWith.lift htrans).bind ?_
    exact ContinuesWith.pure _ s
  refine (ContinuesWith.lift hmem).bind ?_
  exact ContinuesWith.pure _ s

/-- **`fetch () = F_Base w`** (the `StraightLineReady.fetched` field) — the full RV64 base-instruction fetch
under the SP1 machine-mode config: `get_config_rvfi = false` (dead), `ext_fetch_check_pc = none`, PC
4-aligned (`access 0/1 = 0` + `is_aligned_vaddr`), `Ext_Ziccif` enabled, `fetch_bytes` yields the ROM word,
and the word is a full 32-bit instruction (`isRVC = false`). -/
