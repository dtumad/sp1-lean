  exact run_translate_and_read_value_load (reg_val + offset) 1 _ s hs hconfig hmr

/-- One-byte `checked_mem_write` under kernel config (width-1 analogue, for `SB`). -/
lemma run_checked_mem_write_one_byte_of_isInitialized
    (reg_val offset : BitVec 64) (data : BitVec 8)
    (s : SailState) (hs : SailState.isInitialized s)
    (h_in_range : range_subset (zero_extend (BitVec.addInt (reg_val + offset) 0))
      (to_bits 1) (2#64 ^ 16) (2#64 ^ 48 - 2#64 ^ 16) = true)
    (h_aligned : is_aligned_paddr
      (physaddr.Physaddr (zero_extend (BitVec.addInt (reg_val + offset) 0))) 1 = true)
    (h_htif : s.regs.get Register.htif_tohost_base (hs _) = none)
    (h_pmp : s.regs.get Register.pmpcfg_n (hs _) = Vector.replicate 64 0#8)
    (h_pma : s.regs.get Register.pma_regions (hs _) = [SP1_PMA_Region]) :
    let paddr_nat :=
      BitVec.toNat ((zero_extend (BitVec.addInt (reg_val + offset) 0)) : BitVec 64)
    let new_mem := s.mem.insert paddr_nat (BitVec.ofNat 8 data.toNat)
    runSail (checked_mem_write
        (physaddr.Physaddr (zero_extend (BitVec.addInt (reg_val + offset) 0))) 1
        data (MemoryAccessType.Store mem_payload.Data)
        page_based_mem_type.PBMT_PMA Privilege.Machine () false false false) s
      = .ok (.Ok true) { s with mem := new_mem } := by
  exact run_checked_mem_write_aligned _ _ 1 _ s _ hs h_pmp (by norm_num)
    (run_check_pma_store _ 1 s hs h_pma
      (matching_pma_region_sp1 reg_val offset 1 h_in_range) h_aligned)
    (run_within_mmio_writable_mmio reg_val offset 1 s hs h_htif)
    (run_write_ram_one _ _ data s)

/-- One-byte `mem_write_value` under kernel config. -/
lemma run_mem_write_value_one_byte_of_isInitialized
    (reg_val offset : BitVec 64) (data : BitVec 8)
    (s : SailState) (hs : SailState.isInitialized s)
    (h_in_range : range_subset (zero_extend (BitVec.addInt (reg_val + offset) 0))
      (to_bits 1) (2#64 ^ 16) (2#64 ^ 48 - 2#64 ^ 16) = true)
    (h_aligned : is_aligned_paddr
      (physaddr.Physaddr (zero_extend (BitVec.addInt (reg_val + offset) 0))) 1 = true)
    (hconfig : SailState.isValidMemConfig s hs) :
    let paddr_nat :=
      BitVec.toNat ((zero_extend (BitVec.addInt (reg_val + offset) 0)) : BitVec 64)
    let new_mem := s.mem.insert paddr_nat data
    runSail (mem_write_value
        (physaddr.Physaddr (zero_extend (BitVec.addInt (reg_val + offset) 0))) 1
        data Privilege.Machine (MemoryAccessType.Store mem_payload.Data)
        page_based_mem_type.PBMT_PMA false false false) s
      = .ok (.Ok true) { s with mem := new_mem } := by
  apply run_mem_write_value_of_checked
  simpa only [BitVec.ofNat_toNat, BitVec.setWidth_eq] using
    run_checked_mem_write_one_byte_of_isInitialized reg_val offset data
    s hs h_in_range h_aligned hconfig.h_htif_disabled hconfig.h_pmp_off hconfig.h_pma_regions

lemma run_vmem_write_of_width_1
    (rs_addr_bv : BitVec 5)
    (reg_val : BitVec 64)
    (offset : BitVec 64)
    (data : BitVec 8)
    (s : SailState)
    (hs : SailState.isInitialized s)
    (h_reg_val : s.get_reg? rs_addr_bv = some reg_val)
    (h_aligned : is_aligned_vaddr (virtaddr.Virtaddr (reg_val + offset)) 1 = true)
    (hconfig : SailState.isValidMemConfig s hs)
    (h_in_range : range_subset (zero_extend (BitVec.addInt (reg_val + offset) 0))
      (to_bits 1) (2#64 ^ 16) (2#64 ^ 48 - 2#64 ^ 16) = true) :
    runSail (vmem_write (.Regidx rs_addr_bv) offset 1 data
      (MemoryAccessType.Store mem_payload.Data) false false false) s = .ok (.Ok true)
        { s with mem := s.mem.insert (reg_val + offset).toNat data } := by
  have hap := is_aligned_paddr_addInt_of_vaddr (reg_val + offset) 1 h_aligned
  have hea := run_mem_write_ea_of_isInitialized reg_val offset 1 s hs h_in_range hap
    hconfig.h_pma_regions hconfig.h_pmp_off
  have hwv := run_mem_write_value_one_byte_of_isInitialized reg_val offset data s hs h_in_range hap hconfig
  rw [addInt_zero] at hea hwv
  simp only [zero_extend, Sail.BitVec.zeroExtend, BitVec.setWidth_eq] at hwv
  apply run_vmem_write_of_addr rs_addr_bv reg_val offset 1 data
    (MemoryAccessType.Store mem_payload.Data) true s _ hs hconfig h_reg_val
  exact run_vmem_write_addr_aligned _ 0 1 rfl (by decide) data s _ hs h_aligned hconfig hea hwv

end SP1Clean.SailMem
