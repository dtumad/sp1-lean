  unfold vmem_read_explicit
  simp only [LeanRV64D.SailME.run]
  apply ContinuesWith.run
  refine ContinuesWith.bind (value := virtaddr.Virtaddr (base + offset)) (middle := s) ?_ ?_
  · refine (ContinuesWith.lift (run_get_transformed_data_addr_sp1 rs base offset width access s hbase)).bind ?_
