      (MemoryAccessType.Load mem_payload.Data) sp1AccessInfo false false false) s =
      .ok (.Ok (physaddr.Physaddr (zero_extend (m := 64) addr), v)) s := by
  simp only [translate_and_read_value, sp1AccessInfo, runSail_bind,
    run_translateAddr_machine addr (MemoryAccessType.Load mem_payload.Data) rfl s hs hconfig.h_cur_privilege, hread, runSail_pure]

private lemma run_vmem_write_addr_aligned (vaddr_val : BitVec 64) (e width : ℕ)
    (hwidth : width = 2 ^ e) (he : e ≤ 12) (data : BitVec (8 * width))
    (s s' : SailState) (hs : SailState.isInitialized s)
    (h_aligned : is_aligned_vaddr (virtaddr.Virtaddr vaddr_val) width = true)
    (hconfig : SailState.isValidMemConfig s hs)
    (h_ea : runSail (mem_write_ea (physaddr.Physaddr (zero_extend (m := 64) vaddr_val)) width
      Privilege.Machine (MemoryAccessType.Store mem_payload.Data) page_based_mem_type.PBMT_PMA
      false false false) s = .ok (.Ok ()) s)
    (h_wv : runSail (mem_write_value (physaddr.Physaddr (zero_extend (m := 64) vaddr_val)) width data
      Privilege.Machine (MemoryAccessType.Store mem_payload.Data) page_based_mem_type.PBMT_PMA
      false false false) s = .ok (.Ok true) s') :
    runSail (vmem_write_addr (virtaddr.Virtaddr vaddr_val) width data
      (MemoryAccessType.Store mem_payload.Data) sp1AccessInfo false false false) s = .ok (.Ok true) s' := by
  have hpos : 0 < width := by simp [hwidth]
  unfold vmem_write_addr
  simp only [LeanRV64D.SailME.run, is_store_conditional, beq_self_eq_true]
  apply ContinuesWith.run
  refine (ContinuesWith.lift (run_assert_true _ s)).bind ?_
  refine (ContinuesWith.lift (run_readReg_of_isInitialized s Register.cur_privilege hs)).bind ?_
  simp only [match_memory_trigger_before_sp1]
  refine (ContinuesWith.pure none s).bind ?_
  simp only [pure_bind, h_aligned, LeanRV64D.not, Bool.not_true, Bool.false_eq_true, ite_false]
  refine (ContinuesWith.lift (run_split_on_page_boundary_intra _ e width hwidth he
    (toNat_mod_of_is_aligned_vaddr _ width h_aligned ▸ (hwidth ▸ rfl)) s)).bind ?_
  refine ContinuesWith.bind (value := false) (middle := s) ?_ ?_
  · apply ContinuesWith.lift
    simp [sp1AccessInfo,  run_is_vmem_active_machine]
  simp only [sys_misaligned_order_decreasing, Bool.false_and, Bool.and_false, Bool.false_eq_true,
    ite_false, Bool.not_false, Bool.true_and]
  refine (ContinuesWith.pure true s).bind ?_
  refine ContinuesWith.bind (value := true) (middle := s') ?_ ?_
  · refine (ContinuesWith.lift (run_translateAddr_machine vaddr_val
      (MemoryAccessType.Store mem_payload.Data) rfl s hs hconfig.h_cur_privilege)).bind ?_
    refine (ContinuesWith.lift h_ea).bind ?_
    refine ContinuesWith.bind (value := Result.Ok true) (middle := s') ?_ ?_
    · apply ContinuesWith.lift
      show runSail (mem_write_value (physaddr.Physaddr (zero_extend (m := 64) vaddr_val)) width
        (BitVec.setWidth (8 * width) (Sail.BitVec.extractLsb data (8 * (width : Int) - 1).toNat 0))
        Privilege.Machine (MemoryAccessType.Store mem_payload.Data) page_based_mem_type.PBMT_PMA
        false false false) s = .ok (.Ok true) s'
      rw [setWidth_extractLsb_full data rfl (vmem_len_eq width hpos)]
      exact h_wv
    · exact continues_pure_of_eq _ _ s' (by simp)
  refine (ContinuesWith.pure true s').bind ?_
