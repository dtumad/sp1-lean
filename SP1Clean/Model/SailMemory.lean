    (hmem₃ : s.mem[(pc + 0).toNat + 3]? = some data₃) :
    runSail (fetch_bytes pc pc 4) s
      = .ok (FetchBytes_Result.FetchBytes_Success (data₃ ++ data₂ ++ data₁ ++ data₀)) s := by
  have htrans := run_translateAddr_machine pc (MemoryAccessType.InstructionFetch ()) rfl s hs
    hconfig.h_cur_privilege
  have hmem := run_mem_read_four_bytes_fetch_of_isInitialized pc 0 data₀ data₁ data₂ data₃ s hs
    h_in_range (is_aligned_paddr_addInt_of_vaddr (pc + 0) 4
