  ext_control_check_pc currentlyEnabled Sail.BitVec.signExtend

attribute [local simp]
  regidxToRegister_inj
  nextPC_ne_reg_idx_toRegister
  PC_ne_reg_idx_toRegister
  encdec_reg_forwards_matches
  LeanRV64D.readReg
  Std.ExtDHashMap.get?_insert
  Std.ExtDHashMap.get?_insert_self
  Sail.BitVec.toNatInt

attribute [local simp] LeanRV64D.Functions.xlen_bytes PreSail.sail_assert PreSail.assert
  ext_data_get_addr
  split_misaligned misaligned_order
  allowed_misaligned sys_misaligned_order_decreasing
  LeanRV64D.Functions.xlen
  _get_Mstatus_MPP _get_Mstatus_MPRV
  effectivePrivilege
  zopz0zI_u zopz0zK_u
  htif_tohost_size
  LeanRV64D.not

section isValidMemConfig

/-- `plat_have_clint` is set by the SP1 generation config (`platform.clint.supported = false`,
`scripts/sail-config/sp1_rv64d_cfg.json`) into the generated `PlatformConfig.lean`. -/
@[simp] lemma plat_have_clint_eq_false : plat_have_clint = false := rfl

/-- `plat_have_sig` is set by the SP1 generation config
(`platform.simple_interrupt_generator.supported = false`) into the generated `PlatformConfig.lean`. -/
@[simp] lemma plat_have_sig_eq_false : plat_have_sig = false := rfl

-- The PMP constants are deliberately absent from this disclosure block: they are **stock**
-- (`sys_pmp_count = 16`), and PMP-off is carried as the state hypothesis
-- `isValidMemConfig.h_pmp_off` instead of being configured away. See `run_pmpCheck_none`.

/-- Memory access setting for all of memory in our model. -/
@[reducible]
def SP1_PMA : PMA where
  mem_type := MemoryRegionType.MainMemory
  cacheable := false
  coherent := true
  executable := true
  readable := true
  writable := true
  read_idempotent := false
  write_idempotent := false
  misaligned_exceptions := {
    load_store := none
    vector := none
    amo := .AlignmentException
    lrsc := .AlignmentException
  }
  atomic_support := AtomicSupport.AMONone
  reservability := Reservability.RsrvNone
  supports_cbo_zero := false
  supports_pte_read := false
  supports_pte_write := false
  -- Added upstream with the `11d8fa21` model. `mag_of_pma` (`LeanRV64D/Pma.lean:392`) reads `0` as
  -- "no misaligned-atomicity granule", which is the feature-absent value and matches the rest of this
  -- record (AMONone / RsrvNone / no CBO-zero): SP1 guarantees no misaligned atomicity.
  misaligned_atomicity_granule_size_exp := 0
  vector_misaligned_atomicity_granule_size_exp := 0

/-- Single memory region with uniform access across all memory. -/
@[reducible]
def SP1_PMA_Region : PMA_Region where
  base := 2 ^ 16
  size := 2 ^ 48 - 2 ^ 16
  attributes := SP1_PMA
  include_in_device_tree := false

/-- All the registers needed for memory ops are set appropriately. -/
structure SailState.isValidMemConfig (s : SailState) (hs : SailState.isInitialized s) where
  h_cur_privilege : s.regs.get Register.cur_privilege (hs _) = Privilege.Machine
  h_mprv_disabled : BitVec.ofNat 1 ((s.regs.get Register.mstatus (hs _)).toNat >>> 17) = 0#1
  h_mseccfg_disabled : BitVec.ofNat 1 ((s.regs.get Register.mseccfg (hs _)).toNat >>> 10) = 0#1
  h_mseccfg_pmm : BitVec.ofNat 2 ((s.regs.get Register.mseccfg (hs _)).toNat >>> 32) = 0#2
  h_htif_disabled : s.regs.get Register.htif_tohost_base (hs _) = none
  h_pma_regions : s.regs.get Register.pma_regions (hs _) = [SP1_PMA_Region]
  /-- Every PMP entry is OFF. SP1 has no PMP: it implements no CSR instructions at all (its
  disassembler maps every `process_csrr*` to `Instruction::unimp()`), so nothing can ever install
  an entry. This is the same kind of unconstrained-boot-register assumption as `h_mprv_disabled`
  and `h_mseccfg_disabled` above, and it is what lets `run_pmpCheck_none` hold against the stock
  16-entry PMP rather than requiring the generation config to set `sys_pmp_count = 0`. -/
  h_pmp_off : s.regs.get Register.pmpcfg_n (hs _) = Vector.replicate 64 0#8

end isValidMemConfig

/-- The `mstatus.MPRV` bit in the `Sail.BitVec.extractLsb … 17 17` spelling the generated Sail
programs produce, from the `BitVec.ofNat 1 (… >>> 17)` spelling `isValidMemConfig` stores. The two
are definitionally equal; the `rw [show … from rfl]` crosses them by *syntactic* rewriting rather
than leaving the bridge to unification. Factored out of the nineteen `run_*_of_isInitialized`
proofs that each re-derived it. -/
private lemma extractLsb_mstatus_mprv_eq_zero (s : SailState) (hs : SailState.isInitialized s)
    (h_mprv_disabled :
      BitVec.ofNat 1 ((s.regs.get Register.mstatus (hs _)).toNat >>> 17) = 0#1) :
    Sail.BitVec.extractLsb (s.regs.get Register.mstatus (hs _)) 17 17 = 0#1 := by
  rw [show Sail.BitVec.extractLsb (s.regs.get Register.mstatus (hs _)) 17 17 =
    BitVec.ofNat 1 (BitVec.toNat (s.regs.get Register.mstatus (hs _)) >>> 17) from rfl]
  exact h_mprv_disabled

/-- `zero_extend` is idempotent at width 64: `phys_access_check` re-extends the already-extended
physical address, and every `checked_mem_*` reduction has to collapse the double application before
the `range_subset` hypothesis will fire. Factored out of the ten sites that rewrote it inline. -/
private lemma zero_extend_idem_addInt (reg_val offset : BitVec 64) :
    (zero_extend (zero_extend (BitVec.addInt (reg_val + offset) 0) : BitVec 64) : BitVec 64)
      = zero_extend (BitVec.addInt (reg_val + offset) 0) := by
  simp [zero_extend, Sail.BitVec.zeroExtend]

/-- `update_elp_state rs1` (the Zicfilp landing-pad bookkeeping that prefixes `execute_JALR`) is
state-preserving under the SP1 kernel config: the `Ext_Zicfilp` enable check resolves through the
`mseccfg` MLPE bit (disabled), so the `writeReg elp …` branch is dead and the whole step is `pure ()`. -/
lemma update_elp_state_of_isInitialized (rs1 : regidx) (s : SailState)
    (hs : SailState.isInitialized s) (hs' : SailState.isValidMemConfig s hs) :
    runSail (update_elp_state rs1) s = EStateM.Result.ok () s := by
  -- `Seccfg.MLPE` (bit 10 of `mseccfg`) is `0` ⇒ `get_xLPE Machine = false` ⇒ Zicfilp disabled.
  have hmlpe : Sail.BitVec.extractLsb (s.regs.get Register.mseccfg (hs _)) 10 10 = 0#1 := by
    apply BitVec.eq_of_toNat_eq
    rw [Sail.BitVec.extractLsb, BitVec.extractLsb, BitVec.extractLsb'_toNat]
    have h2 := congrArg BitVec.toNat hs'.h_mseccfg_disabled
    simp only [BitVec.toNat_ofNat] at h2 ⊢
    omega
  simp only [andM,  toBool, update_elp_state, currentlyEnabled, get_xLPE, hartSupports, _get_Seccfg_MLPE,
    bool_bit_backwards,  pure_bind, bind_assoc,
    Sail.run_readReg_bind_of_isInitialized s _ hs, hs'.h_cur_privilege, hmlpe]
  rfl

set_option linter.style.native false in
