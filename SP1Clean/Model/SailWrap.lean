set_option linter.unusedSimpArgs false

/-! # Register execution lemmas for the Sail model

The generated model's register accessors are evaluated through `SP1Clean.runSail`, using
upstream ArchSem semantics. These lemmas connect architectural register reads and writes to
SP1's register indices, isolate the pure arithmetic of R-type instructions, and reduce aligned
control transfers. No separate state interpreter or register-writing model is introduced.
-/

open LeanRV64D
open LeanRV64D.Functions
open Sail.ArchSem SP1Clean

set_option linter.style.setOption false

-- Helper functions generated by sail that we generally don't want in practice
attribute [simp] bit_to_bool bits_of_virtaddr bool_bit_backwards Sail.BitVec.access
  ext_control_check_pc currentlyEnabled Sail.BitVec.signExtend

attribute [local simp]
  LeanRV64D.readReg
  regidxToRegister_inj
  nextPC_ne_reg_idx_toRegister
  PC_ne_reg_idx_toRegister
  encdec_reg_forwards_matches
  Std.ExtDHashMap.get?_insert
  Std.ExtDHashMap.get?_insert_self
  Sail.BitVec.toNatInt

attribute [local grind =]
  nextPC_ne_reg_idx_toRegister
  PC_ne_reg_idx_toRegister
  runSail_pure
  runSail_throw

grind_pattern Std.ExtDHashMap.get?_insert_self => (m.insert k v).get? k
grind_pattern BitVec.ofNat_eq_ofNat => (@OfNat.ofNat.{0} (BitVec n) i (@BitVec.instOfNat n i))

/-- A second insert at the same key overwrites the first: collapses the staged `nextPC ← pc+4` write
that a control-flow `jump_to`/`set_next_pc` immediately overwrites with the committed target. -/
@[simp] lemma ExtDHashMap_insert_insert_self {α : Type} {β : α → Type}
    [BEq α] [Hashable α] [LawfulBEq α] [LawfulHashable α]
    (m : Std.ExtDHashMap α β) (k : α) (a b : β k) :
    (m.insert k a).insert k b = m.insert k b := by
  apply Std.ExtDHashMap.ext_get?
  intro k'
  rw [Std.ExtDHashMap.get?_insert, Std.ExtDHashMap.get?_insert, Std.ExtDHashMap.get?_insert]
  split <;> rfl

set_option linter.style.longLine false

section sailboats

variable {α β : Type} {x : α} {idx idx' : BitVec 5} {val val' : BitVec 64} {s : SailState}
  {reg reg' : Register} {v : RegisterType reg} {v' : RegisterType reg'} {typ_0 : regidx}
  {data pc : BitVec 64} {u : Unit}

namespace Option

/-- Version of `Option.getM` using `throw` instead of `failure`. -/
def toSailM {α} (x : Option α) : SailM α :=
  Option.elim x (throw Sail.Error.Unreachable) pure

@[simp] lemma toSailM_none : toSailM (α := α) none = throw Sail.Error.Unreachable := rfl

@[simp] lemma toSailM_some (x : α) : toSailM (some x) = pure x := rfl


end Option

namespace SailState

section get_reg?

/-- Read the value in the register corresponding to `idx`, giving an actual `BitVec 64`.
This avoids the issue of some (unused by us) registers having other length vectors. -/
@[grind] def get_reg? (s : SailState) (idx : BitVec 5) : Option (BitVec 64) :=
  if idx = 0 then some 0 else reg_idx_must_64 idx ▸ s.regs.get? (reg_idx_to_Register idx)

@[simp]
lemma get_reg?_insert_of_ne
  (h : reg ≠ reg_idx_to_Register idx) :
  SailState.get_reg? { s with regs := s.regs.insert reg v } idx =
  SailState.get_reg? s idx := by grind

@[simp]
lemma get_reg?_insert_self
  {s : SailState}
  (v : RegisterType (reg_idx_to_Register idx)) :
  let reg := reg_idx_to_Register idx
  SailState.get_reg? {s with regs := s.regs.insert reg v} idx =
  if idx = 0 then some 0 else reg_idx_must_64 idx ▸ some v := by grind

@[simp]
lemma get_reg?_insert_nextPC {v : RegisterType Register.nextPC} :
  SailState.get_reg? {s with regs := s.regs.insert Register.nextPC v} idx =
  SailState.get_reg? s idx := by aesop

@[simp]
lemma get_reg?_insert_PC {v : RegisterType Register.PC} :
  SailState.get_reg? {s with regs := s.regs.insert Register.PC v} idx =
  SailState.get_reg? s idx := by aesop

end get_reg?

end SailState

namespace Sail

@[simp low]
lemma run_dite (p : Prop) [Decidable p] (mx : p → SailM α) (mx' : ¬ p → SailM α) :
  (runSail (if h : p then mx h else mx' h)) = if h : p then (runSail (mx h)) else (runSail (mx' h)) :=
    apply_dite runSail p mx mx'

@[simp low]
lemma run_ite (p : Prop) [Decidable p] (mx mx' : SailM α) :
  (runSail (if p then mx else mx')) = if p then (runSail mx) else (runSail mx') :=
    apply_ite runSail p mx mx'


section writeReg

@[simp]
lemma run_writeReg :
  (runSail (LeanRV64D.writeReg reg v)) s =
    .ok PUnit.unit { s with regs := s.regs.insert reg v} := rfl

@[simp]
lemma run_writeReg_bind (mx : Unit → SailM α) :
  (runSail (LeanRV64D.writeReg reg v >>= mx)) s =
    (runSail (mx ())) {s with regs := s.regs.insert reg v} := by aesop

end writeReg

section readReg

-- dt: `run_readReg_of_isInitialized` works better with `simp`.
@[simp]
lemma run_readReg (s : SailState) (reg : Register) :
  (runSail (α := no_index (RegisterType reg)) (PreSail.readReg reg)) s = match s.regs.get? reg with
  | some v => .ok v s
  | none => .error Sail.Error.Unreachable s := by
  simp [runSail, PreSail.readReg, interpretSailEffects,
    FreeM.liftM, interpretInstructionEffect]
  cases s.regs.get? reg <;> rfl

lemma run_readReg_of_isInitialized (s : SailState) (reg : Register)
    (hs : SailState.isInitialized s) :
    (runSail (PreSail.readReg reg)) s = .ok (s.regs.get reg (hs reg)) s := by
  rw [run_readReg]
  simp [Std.ExtDHashMap.get?_eq_some_get (hs _)]

/-- Bind version of `run_readReg_of_isInitialized`: inside an `EStateM.bind`,
the `readReg reg` step resolves to `s.regs.get reg _` under `isInitialized`.
Useful when the `readReg` is buried in a `do`-block that can't be collapsed
directly by the `runSail action s` form. -/
lemma run_readReg_bind_of_isInitialized {α : Type}
    (s : SailState) (reg : Register) (hs : SailState.isInitialized s)
    (k : RegisterType reg → SailM α) :
    (runSail (PreSail.readReg reg >>= k)) s = (runSail (k (s.regs.get reg (hs reg)))) s := by
  simp only [runSail_bind, run_readReg_of_isInitialized s reg hs]


@[simp]
lemma run_readReg_insert_of_ne (s : SailState) (h : reg ≠ reg') :
  (runSail (PreSail.readReg reg')) { s with regs := s.regs.insert reg v} =
    match s.regs.get? reg' with
    | some w => .ok w { s with regs := s.regs.insert reg v }
    | none => .error .Unreachable { s with regs := s.regs.insert reg v } := by aesop

@[simp]
lemma run_readReg_insert_self (s : SailState) :
  (runSail (PreSail.readReg reg)) { s with regs := s.regs.insert reg v } =
    .ok v { s with regs := s.regs.insert reg v } := by aesop

/-- Inside `SailME.run`, reading one register (which must be present) and then writing
    another register while discarding the read value simplifies to just the writeReg's
    effect. This shows up in instruction specs where `execute_BTYPE` / `execute_JAL` read
    `Register.misa` purely to check the `C` extension bit before writing `nextPC`. -/
lemma SailME_run_readReg_map_writeReg
    {α : Type} (s : SailState) (reg_r reg_w : Register)
    (hs_r : (s.regs.get? reg_r).isSome) (v : RegisterType reg_w) (f : Unit → α) :
    runSail ((PreSail.PreSailME.run do
        let _ ← liftM (LeanRV64D.readReg reg_r)
        f <$> liftM (LeanRV64D.writeReg reg_w v)) : SailM α) s =
      .ok (f ()) { s with regs := s.regs.insert reg_w v } := by
  rw [Option.isSome_iff_exists] at hs_r
  obtain ⟨v_r, hv_r⟩ := hs_r
  simp only [map_eq_pure_bind, PreSail.PreSailME.run_lift_bind,
    PreSail.PreSailME.run_pure, runSail_bind, run_readReg, hv_r, run_writeReg, runSail_pure]


end readReg

section rX_bits

-- A 32-way `fin_cases` peel of `rX_bits`/`rX`, each arm closed by a deep `simp` over the
-- generated Sail definitions.
lemma rX_bits_eq_get_reg? {s : SailState} :
  (runSail (rX_bits (regidx.Regidx idx))) s = (runSail (s.get_reg? idx).toSailM) s := by
  fin_cases idx <;>
    simp [Option.toSailM, SailState.get_reg?, Option.elim, reg_idx_to_Register, rX_bits, rX, regval_from_reg, map_eq_pure_bind] <;>
    (first | rfl | (cases s.regs.get? _ <;> rfl))

@[simp high]
lemma run_rX_bits :
  (runSail (rX_bits (.Regidx idx))) s =
  match SailState.get_reg? s idx with
  | some v => .ok v s
  | none => .error Sail.Error.Unreachable s
    := by
  rw [rX_bits_eq_get_reg?]; aesop

end rX_bits

section wX_bits

@[simp high]
lemma run_wX_bits (reg : regidx) (data : BitVec 64) :
  (runSail (wX_bits reg data)) s = let .Regidx idx := reg
    .ok () (if idx = 0#5 then s else {s with
      regs := s.regs.insert (reg_idx_to_Register idx) (bitVecToRegidxVal idx data)}) := by
  let .Regidx idx := reg
  fin_cases idx <;>
    simp [wX_bits, wX, xreg_write_callback, xreg_full_write_callback, reg_name_forwards,
      get_config_use_abi_names, LeanRV64D.not, regval_into_reg, reg_idx_to_Register,
      BitVec.toNatInt, bitVecToRegidxVal]


end wX_bits

section pc

@[simp] lemma set_next_pc_eq :
  set_next_pc pc = LeanRV64D.writeReg Register.nextPC pc := rfl

@[simp] lemma get_next_pc_eq :
  get_next_pc u = PreSail.readReg Register.nextPC := rfl

@[simp] lemma run_tick_pc (s : SailState) :
  runSail (tick_pc u) s =
    runSail (do LeanRV64D.writeReg Register.PC (← PreSail.readReg Register.nextPC)) s := by
  simp only [tick_pc, LeanRV64D.readReg, map_eq_pure_bind, runSail_bind, run_readReg, run_writeReg,
    Std.ExtDHashMap.get?_insert_self, pc_write_callback, runSail_pure]
  cases s.regs.get? Register.nextPC <;> rfl


end pc

end Sail

end sailboats

section execution

variable {b : Bool} {rs1 rs2 rd : regidx}
open PreSail
open LeanRV64D.Functions

@[simp]
lemma bool_bits_forwards_to_if :
  bool_bit_forwards b = if b then 1#1 else 0#1 := by aesop

section RTYPE

variable {op : rop}

/-- `execute_RTYPE` pure part -/
def execute_RTYPE_pure (op1 : BitVec 64) (op2 : BitVec 64) (op : rop) :=
  match op with
  | .ADD => op1 + op2
  | .SLT => zero_extend (m := 64) (bool_to_bit (zopz0zI_s op1 op2))
  | .SLTU => zero_extend (m := 64) (bool_to_bit (zopz0zI_u op1 op2))
  | .AND => op1 &&& op2
  | .OR => op1 ||| op2
  | .XOR => op1 ^^^ op2
  | .SLL => Sail.shift_bits_left op1 (Sail.BitVec.extractLsb op2 (LeanRV64D.Functions.log2_xlen -i 1) 0)
  | .SRL => Sail.shift_bits_right op1 (Sail.BitVec.extractLsb op2 (LeanRV64D.Functions.log2_xlen -i 1) 0)
  | .SUB => op1 - op2
  | .SRA => shift_bits_right_arith op1 (Sail.BitVec.extractLsb op2 (LeanRV64D.Functions.log2_xlen -i 1) 0)

/-- `execute_RTYPE` with isolated pure part -/
def execute_RTYPE' (rs2 : regidx) (rs1 : regidx) (rd : regidx) (op : rop) : SailM ExecutionResult := do
  let rs1_bits ← do (rX_bits rs1)
  let rs2_bits ← do (rX_bits rs2)
  (wX_bits rd (execute_RTYPE_pure rs1_bits rs2_bits op))
  (pure RETIRE_SUCCESS)

@[simp]
lemma execute_RTYPE_eq_execute_RTYPE' :
  execute_RTYPE rs2 rs1 rd op = execute_RTYPE' rs2 rs1 rd op
  := by cases op <;> simp_all [execute_RTYPE', execute_RTYPE, execute_RTYPE_pure, LeanRV64D.Functions.xlen]

end RTYPE

section RTYPEW

variable {op : ropw}

/-- `execute_RTYPEW` pure part: the W-instructions operate on the low 32 bits of the
operands and **sign-extend** the 32-bit result back to 64 bits (verbatim from the Sail
`execute_RTYPEW` body in `LeanRV64D/InstsEnd.lean`). -/
def execute_RTYPEW_pure (op1 : BitVec 64) (op2 : BitVec 64) (op : ropw) : BitVec 64 :=
  let rs1_val := Sail.BitVec.extractLsb op1 31 0
  let rs2_val := Sail.BitVec.extractLsb op2 31 0
  let result : (BitVec 32) :=
    match op with
    | .ADDW => (rs1_val + rs2_val)
    | .SUBW => (rs1_val - rs2_val)
    | .SLLW => (Sail.shift_bits_left rs1_val (Sail.BitVec.extractLsb rs2_val 4 0))
    | .SRLW => (Sail.shift_bits_right rs1_val (Sail.BitVec.extractLsb rs2_val 4 0))
    | .SRAW => (shift_bits_right_arith rs1_val (Sail.BitVec.extractLsb rs2_val 4 0))
  (sign_extend (m := 64) result)

/-- `execute_RTYPEW` with isolated pure part. -/
def execute_RTYPEW' (rs2 : regidx) (rs1 : regidx) (rd : regidx) (op : ropw) : SailM ExecutionResult := do
  let rs1_bits ← do (rX_bits rs1)
  let rs2_bits ← do (rX_bits rs2)
  (wX_bits rd (execute_RTYPEW_pure rs1_bits rs2_bits op))
  (pure RETIRE_SUCCESS)

@[simp]
lemma execute_RTYPEW_eq_execute_RTYPEW' :
  execute_RTYPEW rs2 rs1 rd op = execute_RTYPEW' rs2 rs1 rd op
  := by cases op <;> simp_all [execute_RTYPEW', execute_RTYPEW, execute_RTYPEW_pure]

end RTYPEW

section jump

/-- In the pinned generated Sail model, `jump_to target` runs:
  1. an extension hook `ext_control_check_pc target` (constant `none`),
  2. an `assert` that `target` bit 0 is `0`,
  3. an `if (bit_to_bool (target bit 1)) && (not (← currentlyEnabled Ext_Zca))` guard, else
  4. `set_next_pc target; pure RETIRE_SUCCESS`.
For `target % 4 = 0` both low bits are zero. The assertion passes and the generated monadic
conjunction short-circuits before reading the Zca extension flag. No initialization premise is
needed for this step. The control-flow bridges use this to reduce `jump_to` to one `nextPC` write. -/
theorem jump_to_of_mod4_eq_zero (target : BitVec 64) (s : SailState)
    (h_aligned : target % 4#64 = 0) :
    runSail (jump_to target) s =
      EStateM.Result.ok LeanRV64D.Functions.RETIRE_SUCCESS
        { s with regs := s.regs.insert Register.nextPC target } := by
  have h0 : target[0] = false := by bv_decide
  have h1 : target[1] = false := by bv_decide
  simp [jump_to, ext_control_check_pc, PreSail.sail_assert, andM, toBool, h0, h1]
  rfl


end jump

end execution
