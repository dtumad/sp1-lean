import SP1Clean.Proofs.Completeness.MixedSyscallRows
import SP1Clean.Soundness.HostCallLedger
import ToClean.Air.DemandPadding

/-! # Constructing the instruction-to-host table from the mixed compiler

The original installed ECALL component consumes every active syscall instruction input.
Its canonical demand padding is included, and all active and padding constraints are proved
for the literal physical arrays generated by Clean.
-/

namespace SP1Clean.TraceGen.MixedSyscallTable

open Circuit Air.Flat Semantics Soundness Machine FormalModel.Shard
open WitnessGeneration

private abbrev F := ZMod SP1Prime
private abbrev component := HostCallLedger.producer (p := SP1Prime)
private abbrev Input := SyscallInstrsChip.Inputs F


/-- The released 65-column inactive instruction, with every selector and timestamp disabled. -/
def padding : Input :=
  { state := 0, op_a := 0, op_a_memory := ⟨#v[0, 0, 0, 0], 0⟩, op_a_0 := 0,
    op_b := 0, op_b_memory := 0, op_c := 0, op_c_memory := 0, next_pc := 0,
    is_halt := 0, op_a_value := 0, syscall_id_bytes := ⟨#v[0, 0, 0, 0]⟩,
    is_enter_unconstrained := ⟨0, 0⟩, is_hint_len := ⟨0, 0⟩, is_halt_zero := ⟨0, 0⟩,
    is_commit := ⟨0, 0⟩, is_commit_deferred := ⟨0, 0⟩, digest_index_bits := #v[0, 0, 0, 0, 0, 0, 0, 0],
    digest_word := 0, op_b_cmp := ⟨0⟩, op_c_cmp := ⟨0⟩, is_real := 0 }

/-- The original instruction-to-host component uses the all-zero ECALL input as its
demand padding, at every shard height. -/
theorem generation_padding : ∃ mode, component.generation = .demand mode ∧ mode.padding = padding := by
  refine ⟨_, rfl, ?_⟩
  apply ProvableType.toElements_inj_iff.mp
  decide +kernel

private theorem padding_valid (data : ProverData F) (hint : ProverHint F) :
    component.circuit.ProverAssumptions padding data hint := by
  let r := padding
  change SyscallInstrsChip.RowContract r ∧ SyscallCodeGuard.Spec ⟨r.op_a_memory.prev_value, r.is_real⟩
  have off : r.is_real = 0 := rfl
  have halt : r.is_halt = 0 := rfl
  have commit : r.is_commit.result = 0 := rfl
  have deferred : r.is_commit_deferred.result = 0 := rfl
  have a0 : r.op_a_0 = 0 := rfl
  have byte : SyscallInstrsChip.tableByte r = 0 := by change ((0 : F) - 0) * _ = 0; simp
  have b : r.op_b_cmp.bit = 0 := rfl
  have c : r.op_c_cmp.bit = 0 := rfl
  simp [SyscallInstrsChip.RowContract, SyscallCodeGuard.Spec, SyscallInstrsChip.GatesBoolean,
    Readers.CPUState.Spec, Readers.RegisterAccessCols.Spec, Readers.RegisterAccessTimestamp.Spec, SyscallInstrsChip.SelectorsValid,
    U16toU8OperationSafe.Spec, SyscallInstrsChip.toWriteArm, SyscallInstrsChip.WriteArm.Assumptions,
    SyscallInstrsChip.WriteArm.Spec, SyscallInstrsChip.toPcArm, SyscallInstrsChip.PcArm.Assumptions,
    SyscallInstrsChip.PcArm.Spec, SyscallInstrsChip.toDispatchArm, SyscallInstrsChip.DispatchArm.Assumptions,
    SyscallInstrsChip.DispatchArm.Spec, SyscallInstrsChip.toFieldBoundB, SyscallInstrsChip.toFieldBoundC,
    SyscallInstrsChip.FieldBoundArm.Assumptions, SyscallInstrsChip.FieldBoundArm.Spec,
    SyscallInstrsChip.toCommitArm, SyscallInstrsChip.CommitArm.Assumptions, SyscallInstrsChip.CommitArm.Spec,
    SyscallInstrsChip.PulledFacts, off, halt, commit, deferred, a0, byte, b, c]

/-- Physical ECALL inputs in chronological order, followed by the demand scheduler's suffix. -/
def inputs (compiled : List MixedCompiledRow) : List Input :=
  let live := compiled.filterMap MixedCompiledRow.syscallInput?
  live ++ List.replicate (demandPadding live.length) padding

private theorem height (compiled : List MixedCompiledRow) :
    (inputs compiled).length = demandHeight (compiled.filterMap (MixedCompiledRow.syscallInput? (p := SP1Prime))).length := by
  simp [inputs, add_demandPadding]

/-- Clean's generated original instruction-to-host table. -/
def table (compiled : List MixedCompiledRow) (data : ProverData F) (hint : ProverHint F)
    (fit : demandHeight (compiled.filterMap (MixedCompiledRow.syscallInput? (p := SP1Prime))).length ≤ UInt64.size) : Table F :=
  let rows := inputs compiled
  Table.build component rows (component.inputData rows data) hint ((height compiled).trans_le fit)
    (by trivial) (component.inputData_consistent rows data)

/-- The ECALL table has the exact rounded height of its generated instruction rows. -/
theorem table_length (compiled : List MixedCompiledRow) (data : ProverData F) (hint : ProverHint F) (fit) :
    (table compiled data hint fit).length = demandHeight (compiled.filterMap (MixedCompiledRow.syscallInput? (p := SP1Prime))).length :=
  (List.length_map ..).trans (height compiled)

/-- Decoding the physical arrays recovers exactly the active compiler inputs for the eight calls. -/
theorem active (compiled : List MixedCompiledRow) (data evaluation : ProverData F) (hint : ProverHint F) (fit) :
    ((HostCallLedger.activeRows (table compiled data hint fit) evaluation).map HostCallLedger.input) =
      compiled.filterMap MixedCompiledRow.syscallInput? := by
  let : DecidableEq F := FiniteField.instDecidableEq
  let original := table compiled data hint fit
  let env := fun (row : Input) => Environment.fromArray (component.buildRow row original.data hint) evaluation
  have get (r : Input) : HostCallLedger.input (env r) = r :=
    component.rowInput_buildRow r original.data evaluation hint
  have live (r : Input) (inRows : r ∈ compiled.filterMap MixedCompiledRow.syscallInput?) : r.is_real = 1 := by
    obtain ⟨entry, _, selected⟩ := List.mem_filterMap.mp inRows
    cases entry with
    | ordinary => contradiction
    | syscall frontier base call => cases selected; rfl
  have arrays : (original.table.map (Environment.fromArray · evaluation)) = (inputs compiled).map env :=
    List.map_map (l := inputs compiled) (f := fun (r : Input) => component.buildRow r original.data hint) (g := fun row => Environment.fromArray row evaluation)
  rw [HostCallLedger.activeRows, arrays]
  change (((inputs compiled).map env).filter (fun e => decide ((HostCallLedger.input e).is_real = 1))).map HostCallLedger.input = _
  rw [List.filter_map, List.map_map]
  simp only [Function.comp_def, get, inputs, List.filter_append, List.filter_replicate]
  rw [List.filter_eq_self.mpr (fun r member => decide_eq_true (live r member))]
  simp [show padding.is_real = 0 from rfl]

/-- Every constructed row satisfies the installed circuit on a genuine mixed execution. -/
theorem checked {limits : ResourceLimits} {image : ProgramImage} {source target : ExecutionSnapshot}
    {events : List ExecutionEvent} {compiled : List MixedCompiledRow}
    (run : AdmissibleExecution limits SP1Prime image source target events)
    (routed : routeMixedRows? (policy SP1Prime image) image.program AccessFrontier.initial source.realize events = some compiled)
    (data : ProverData F) (hint : ProverHint F) (fit) :
    (table compiled data hint fit).Constraints ∧ (table compiled data hint fit).Guarantees := by
  obtain ⟨other, built, ready⟩ := admissibleExecution_syscallInputs run
  obtain rfl := Option.some.inj (routed.symm.trans built)
  have valid (r : Input) (member : r ∈ inputs compiled) : ∀ data hint, component.circuit.ProverAssumptions r data hint := by
    rcases List.mem_append.mp member with used | padding
    · obtain ⟨i, bound, eq⟩ := List.mem_iff_getElem.mp used
      subst r
      exact (ready.get (i := i) (by rw [ready.length_eq]; exact bound) bound).2.2
    · rw [List.eq_of_mem_replicate padding]
      exact padding_valid
  dsimp only [table]
  exact ⟨Table.build_constraints _ _ _ _ _ _ _ (fun r m => valid r m _ _),
    Table.build_guarantees _ _ _ _ _ _ _ (fun r m => valid r m _ _)⟩

/-- A genuine run constructs a checked physical table with precisely its active ECALL
inputs. The demand height follows from the execution clock, including for an empty tape. -/
theorem of_execution {limits : ResourceLimits} {image : ProgramImage} {source target : ExecutionSnapshot}
    {events : List ExecutionEvent} (run : AdmissibleExecution limits SP1Prime image source target events)
    (data : ProverData F) (hint : ProverHint F) :
    ∃ compiled, routeMixedRows? (policy SP1Prime image) image.program AccessFrontier.initial source.realize events = some compiled ∧
      ∃ fit, let original := table compiled data hint fit
             original.Constraints ∧ original.Guarantees ∧
             original.length = demandHeight (compiled.filterMap (MixedCompiledRow.syscallInput? (p := SP1Prime))).length ∧
             ∀ evaluation, (HostCallLedger.activeRows original evaluation).map HostCallLedger.input =
               compiled.filterMap MixedCompiledRow.syscallInput? := by
  obtain ⟨compiled, built, length⟩ := admissibleExecution_routeMixedRows run
  let calls := compiled.filterMap (MixedCompiledRow.syscallInput? (p := SP1Prime))
  have small : calls.length ≤ compiled.length := List.length_filterMap_le _ _
  have ticks := run.1.clock
  have count := event_count_le_ticks events
  have last : target.clock < 2 ^ 48 := run.2.2.2.2.2.1
  have upper := (demandHeight_bounds calls.length).2
  have fit : demandHeight calls.length ≤ UInt64.size := by change _ ≤ 2 ^ 64; omega
  obtain ⟨constraints, guarantees⟩ := checked run built data hint fit
  exact ⟨compiled, built, fit, constraints, guarantees, (List.length_map ..).trans (height compiled),
    fun evaluation => active compiled data evaluation hint fit⟩

end SP1Clean.TraceGen.MixedSyscallTable
